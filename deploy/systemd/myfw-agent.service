[Unit]
Description=myfw agent (restricted, socket-only control of the firewall)
After=myfw-boot.service
Requires=myfw-boot.service

[Service]
Type=notify
NotifyAccess=main
ExecStart=/usr/local/sbin/myfw-agent
Restart=on-failure
RestartSec=1
# The socket and state files get group myfw-read; access is checked per request.
Group=myfw-read
UMask=0027
# Measured needs: CAP_NET_ADMIN for netlink, CAP_SYS_ADMIN only for
# `ip netns exec` of the lab probes. No module loading, no other caps.
CapabilityBoundingSet=CAP_NET_ADMIN CAP_SYS_ADMIN
NoNewPrivileges=yes
ProtectKernelModules=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadWritePaths=/var/lib/myfw /run/myfw
RestrictAddressFamilies=AF_UNIX AF_NETLINK AF_INET
LockPersonality=yes

[Install]
WantedBy=multi-user.target
