{
 "__inputs": [
  {
   "name": "DS_PROMETHEUS",
   "label": "Prometheus",
   "type": "datasource",
   "pluginId": "prometheus"
  }
 ],
 "title": "myfw firewall",
 "uid": "myfw-overview",
 "schemaVersion": 39,
 "version": 1,
 "editable": true,
 "time": {
  "from": "now-1h",
  "to": "now"
 },
 "refresh": "30s",
 "tags": [
  "myfw",
  "firewall"
 ],
 "annotations": {
  "list": [
   {
    "name": "commits",
    "datasource": {
     "type": "prometheus",
     "uid": "${DS_PROMETHEUS}"
    },
    "enable": true,
    "iconColor": "orange",
    "expr": "changes(myfw_generation[1m]) > 0",
    "titleFormat": "policy commit"
   }
  ]
 },
 "panels": [
  {
   "type": "row",
   "title": "1. Health",
   "id": 1,
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 1
   },
   "collapsed": false
  },
  {
   "type": "stat",
   "title": "Collector up",
   "id": 2,
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "description": "0 means the firewall series below are absent, not zero",
   "gridPos": {
    "x": 0,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "myfw_collector_up",
     "legendFormat": "collector",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "type": "stat",
   "title": "Kernel reachable",
   "id": 3,
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "description": "",
   "gridPos": {
    "x": 4,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "myfw_up",
     "legendFormat": "kernel",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "type": "stat",
   "title": "Guard up",
   "id": 4,
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "description": "",
   "gridPos": {
    "x": 8,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "myfw_guard_up",
     "legendFormat": "guard",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "type": "stat",
   "title": "Policy generation",
   "id": 5,
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "description": "",
   "gridPos": {
    "x": 12,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "myfw_generation",
     "legendFormat": "generation",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "type": "stat",
   "title": "Change pending",
   "id": 6,
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "description": "",
   "gridPos": {
    "x": 16,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "myfw_change_pending",
     "legendFormat": "pending",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "type": "table",
   "title": "Required-service probes",
   "id": 7,
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "description": "",
   "gridPos": {
    "x": 20,
    "y": 1,
    "w": 4,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "myfw_service_probe_success",
     "legendFormat": "{{probe}} ({{expect}})",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "type": "row",
   "title": "2. Traffic and drops",
   "id": 8,
   "gridPos": {
    "x": 0,
    "y": 5,
    "w": 24,
    "h": 1
   },
   "collapsed": false
  },
  {
   "type": "timeseries",
   "title": "Final verdicts (packets/s)",
   "id": 9,
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "description": "",
   "gridPos": {
    "x": 0,
    "y": 6,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (verdict) (rate(myfw_packets_total[1m]))",
     "legendFormat": "{{verdict}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "pps"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "type": "timeseries",
   "title": "Drops by reason (packets/s)",
   "id": 10,
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "description": "",
   "gridPos": {
    "x": 8,
    "y": 6,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(myfw_drops_total[1m]) > 0",
     "legendFormat": "{{reason}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "pps"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "type": "timeseries",
   "title": "Verdicts by ingress zone (packets/s)",
   "id": 11,
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "description": "",
   "gridPos": {
    "x": 16,
    "y": 6,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "rate(myfw_zone_packets_total[1m])",
     "legendFormat": "{{zone}} {{verdict}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "pps"
    },
    "overrides": []
   },
   "options": {}
  },
  {
   "type": "row",
   "title": "3. Capacity",
   "id": 12,
   "gridPos": {
    "x": 0,
    "y": 13,
    "w": 24,
    "h": 1
   },
   "collapsed": false
  },
  {
   "type": "timeseries",
   "title": "Flow table",
   "id": 13,
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "description": "",
   "gridPos": {
    "x": 0,
    "y": 14,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "myfw_connections",
     "legendFormat": "flows",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    },
    {
     "refId": "B",
     "expr": "myfw_connection_limit",
     "legendFormat": "limit",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "type": "timeseries",
   "title": "Fail-closed events (per 5m)",
   "id": 14,
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "description": "",
   "gridPos": {
    "x": 8,
    "y": 14,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "increase(myfw_drops_total{reason=~\"flow_table_full|nat_allocation_failed|no_memory\"}[5m])",
     "legendFormat": "{{reason}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "type": "timeseries",
   "title": "Event log loss (per 10m)",
   "id": 15,
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "description": "",
   "gridPos": {
    "x": 16,
    "y": 14,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "increase(myfw_collector_events_lost_total[10m])",
     "legendFormat": "lost before collection",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    },
    {
     "refId": "B",
     "expr": "increase(myfw_events_overwritten_total[10m])",
     "legendFormat": "overwritten in kernel ring",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    },
    {
     "refId": "C",
     "expr": "increase(myfw_events_suppressed_total[10m])",
     "legendFormat": "rate-limited",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "type": "row",
   "title": "4. Change timeline",
   "id": 16,
   "gridPos": {
    "x": 0,
    "y": 21,
    "w": 24,
    "h": 1
   },
   "collapsed": false
  },
  {
   "type": "timeseries",
   "title": "Generation",
   "id": 17,
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "description": "",
   "gridPos": {
    "x": 0,
    "y": 22,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "myfw_generation",
     "legendFormat": "generation",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "type": "timeseries",
   "title": "Changes by outcome (per 10m)",
   "id": 18,
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "description": "",
   "gridPos": {
    "x": 8,
    "y": 22,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "increase(myfw_changes_total[10m])",
     "legendFormat": "{{state}}",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {},
    "overrides": []
   },
   "options": {}
  },
  {
   "type": "timeseries",
   "title": "Commit gate time",
   "id": 19,
   "datasource": {
    "type": "prometheus",
    "uid": "${DS_PROMETHEUS}"
   },
   "description": "Time new flows were held while the policy pointer was switched",
   "gridPos": {
    "x": 16,
    "y": 22,
    "w": 8,
    "h": 7
   },
   "targets": [
    {
     "refId": "A",
     "expr": "myfw_last_gate_seconds",
     "legendFormat": "gate",
     "datasource": {
      "type": "prometheus",
      "uid": "${DS_PROMETHEUS}"
     }
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "options": {}
  }
 ]
}